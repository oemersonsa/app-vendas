{
  "name": "dashboard-vendas",
  "version": "1.1.0",
  "description": "Dashboard de Vendas",
  "main": "src/electron-main.js",
  "author": "Emerson Santos",
  "build": {
    "appId": "com.seuapp.dashboard-vendas",
    "productName": "Dashboard Vendas",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "public/**/*",
      "package.json"
    ],
    "linux": {
      "target": [
        "deb",
        "AppImage"
      ],
      "category": "Office",
      "maintainer": "emersonsads@gmail.com",
      "packageCategory": "utils"
    },
    "deb": {
      "depends": [
        "libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0",
        "libdrm2",
        "libgbm1"
      ]
    }
  },
  "scripts": {
    "build:linux": "electron-builder --linux",
    "build:deb": "electron-builder --linux deb"
  }
}
