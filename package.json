{
  "name": "dashboard-vendas",
  "version": "1.0.0",
  "private": true,
  "description": "Dashboard de vendas com persistencia SQLite via backend",
  "main": "electron-main.js",
  "scripts": {
    "start": "node server.js",
    "desktop": "electron .",
    "dist": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "35",
    "electron-builder": "latest"
  },
  "build": {
    "appId": "br.com.dashboardvendas.app",
    "productName": "Dashboard de Vendas",
    "directories": {
      "output": "dist"
    },
    "files": [
      "app.js",
      "database.js",
      "electron-main.js",
      "favicon.svg",
      "index.html",
      "server.js",
      "styles.css",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "engines": {
    "node": ">=22.5"
  }
}
